# Supabase Public Configuration (used by Next.js client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Configuration (never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini API (used by worker and server-side assistant route)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TIER=free

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
