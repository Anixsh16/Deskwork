SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Use the Session pooler string from Supabase > Connect (port 5432) for your project's region.
DATABASE_URL=postgresql://postgres.your-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres
# One key, or several separated by commas: when one key reaches a daily free-tier limit, the next is used.
GEMINI_API_KEY=your-gemini-key
# Comma separated Google accounts allowed to use Deskwork.
ALLOWED_TEACHER_EMAILS=you@example.com
FRONTEND_ORIGIN=http://localhost:3000
# Pinecone for cloud deployment. Use chroma for an offline local vector store.
VECTOR_PROVIDER=pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_HOST=your-index-host.svc.pinecone.io
PINECONE_NAMESPACE=deskwork-v1
